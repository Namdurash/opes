# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# The sandbox configurations are copies of Debug/Release, so CocoaPods is told which
# one each inherits from — without this the pods' xcconfig is not applied to them.
project 'opes', 'Debug-Sandbox' => :debug, 'Release-Sandbox' => :release

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

pod 'simdjson', path: '../node_modules/@nozbe/simdjson', modular_headers: true

target 'opes' do
  config = use_native_modules!

  pod 'RNWorklets', :path => '../node_modules/react-native-worklets'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-config bakes the env file in from a "Config codegen" script phase that
    # runs on ITS OWN pod target, so an ENVFILE set on the app target never reaches it —
    # the codegen silently falls back to `.env`. Setting it here, per configuration, is
    # what actually makes the sandbox build read `.env.sandbox`, and it lives in the
    # Podfile so `pod install` cannot drop it.
    installer.pods_project.targets.each do |pod_target|
      next unless pod_target.name == 'react-native-config'
      pod_target.build_configurations.each do |pod_config|
        pod_config.build_settings['ENVFILE'] =
          pod_config.name.end_with?('-Sandbox') ? '.env.sandbox' : '.env'
      end
    end
  end
end
